# Copy to .env.local and fill in values from Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# --- Server-only (never prefix these with NEXT_PUBLIC_) ---

# Weather page: free key from https://openweathermap.org/api (Current + 5 day forecast).
# Without it the page shows sample data.
OPENWEATHER_API_KEY=
# Default location when the farm has none set in Settings
NEXT_PUBLIC_WEATHER_LOCATION=Buea

# SMS alerts on the Messages page (Twilio). Without these, SMS is disabled and the
# message board still works. TWILIO_FROM_NUMBER is an SMS-capable number in E.164
# format (e.g. +15005550006) or an approved alphanumeric sender ID.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
